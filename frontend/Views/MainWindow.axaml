<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cody.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="Cody.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cody"
        Width="1200"
        Height="800">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Orientation="Horizontal">
        <StackPanel Orientation="Vertical" Width="800">
            <SplitButton Content="Load Program">
                <SplitButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuItem Header="Load Example">
                            <MenuItem Header="Basic" Click="LoadBasicExampleProgram" />
                            <MenuItem Header="Advanced" Click="LoadAdvancedExampleProgram" />
                            <MenuItem Header="Expert" Click="LoadExpertExampleProgram" />
                        </MenuItem>
                        <MenuItem Header="Load from file" Click="LoadProgramFromFile" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <TextBox Width="700" Height="600" AcceptsReturn="True" AcceptsTab="True" Name="ProgramTextBox"></TextBox>
            <StackPanel Orientation="Horizontal">
                <Button Click="Run">Run</Button>
                <Button Click="CalculateMetrics">Calculate Metrics</Button>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Vertical" Width="400">
            <TextBlock>Draw a visualized grid of a program here somehow...</TextBlock>
            <Image Width="350" Height="350"
                   Stretch="Uniform"
                   Source="../Assets/CodyTopview.png"/>
            <TextBlock Width="350" Height="420" Name="OutputTextBlock" TextWrapping="Wrap">Output will appear here.</TextBlock>
        </StackPanel>
    </StackPanel>

    <!-- <StackPanel Orientation="Horizontal" >
    <Border Margin="5" CornerRadius="10" Background="LightBlue">
    <TextBlock Margin="5"
    FontSize="24"
    HorizontalAlignment="Center"
    Text="Temperature Converter" />

    </Border>
    <Grid ShowGridLines="True" Margin="5"
    ColumnDefinitions="120, 100"
    RowDefinitions="Auto, Auto">
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="10">Celsius</TextBlock>
    <TextBox Grid.Row="0" Grid.Column="1" Margin="0 5" Text="0"/>
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="10">Fahrenheit</TextBlock>
    <TextBox Grid.Row="1" Grid.Column="1" Margin="0 5" Text="0"/>
    </Grid>
    <Button HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_OnClick">Random Example Program!</Button>
    <Image Width="200" Height="200"
    Stretch="Uniform"
    Source="../Assets/CodyTopview.png"/>
    </StackPanel> -->

</Window>
