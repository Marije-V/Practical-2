<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cody.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1375" d:DesignHeight="900"
        x:Class="Cody.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/CodyHead.png"
        Title="Cody"
        Width="1375"
        Height="900"
        FontFamily="/Assets/Fonts#Courier New"
        FontSize="20"
        Background="AntiqueWhite"
        Foreground="Black">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Orientation="Horizontal" Margin="10">
        <StackPanel Orientation="Vertical" Width="800" Margin="10">
            <StackPanel Orientation="Horizontal">
                <SplitButton Content="Load Program" Padding="9" Margin="5" Background="#e27a1f">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuItem Header="Load Example">
                                <MenuItem Header="Basic" Click="LoadBasicExampleProgram" />
                                <MenuItem Header="Advanced" Click="LoadAdvancedExampleProgram" />
                                <MenuItem Header="Expert" Click="LoadExpertExampleProgram" />
                            </MenuItem>
                            <MenuItem Header="Load from file" Click="LoadProgramFromFile" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <TextBox Padding="9" Margin="5" Name="ProgramName">Untitled Program</TextBox>
                <Button Padding="9" Margin="5" Background="#ad037a" Foreground="AntiqueWhite">Save</Button>
            </StackPanel>
            <TextBox Width="700" Height="600" AcceptsReturn="True" AcceptsTab="False" Name="ProgramTextBox" Margin="10" Padding="9"></TextBox>
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                <Button Click="Run" Margin="10" Padding="9" Background="#790656" Foreground="AntiqueWhite">Run</Button>
                <Button Click="CalculateMetrics" Padding="9" Background="#f292d0">Calculate Metrics</Button>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Vertical" Width="500">
            <TextBlock TextWrapping="Wrap">Draw a visualized grid of a program here somehow...</TextBlock>
            <Image Width="350" Height="350"
                   Margin="50"
                   Stretch="Uniform"
                   Source="../Assets/CodyTopview.png"/>
            <Border Margin="10" Padding="9" CornerRadius="9" Background="#efa869">
                <TextBlock Height="300" Width="425" Name="OutputTextBlock" TextWrapping="Wrap" Margin="10">Output will appear here.</TextBlock>
            </Border>
        </StackPanel>
    </StackPanel>

    <!-- <StackPanel Orientation="Horizontal" >
    <Border Margin="5" CornerRadius="10" Background="LightBlue">
    <TextBlock Margin="5"
    FontSize="24"
    HorizontalAlignment="Center"
    Text="Temperature Converter" />

    </Border>
    <Grid ShowGridLines="True" Margin="5"
    ColumnDefinitions="120, 100"
    RowDefinitions="Auto, Auto">
    <TextBlock Grid.Row="0" Grid.Column="0" Margin="10">Celsius</TextBlock>
    <TextBox Grid.Row="0" Grid.Column="1" Margin="0 5" Text="0"/>
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="10">Fahrenheit</TextBlock>
    <TextBox Grid.Row="1" Grid.Column="1" Margin="0 5" Text="0"/>
    </Grid>
    <Button HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_OnClick">Random Example Program!</Button>
    <Image Width="200" Height="200"
    Stretch="Uniform"
    Source="../Assets/CodyTopview.png"/>
    </StackPanel> -->

</Window>
